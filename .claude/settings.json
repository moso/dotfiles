{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "0",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "autoConnectIde": true,
  "forceLoginMethod": "claudeai",
  "includeGitInstructions": false,
  "inputNeededNotifEnabled": true,
  "learnMode": false,
  "model": "claude-opus-5",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "outputStyle": "Concise",
  "preferredNotifChannel": "auto",
  "permissions": {
    "allow": [
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Read(./.gitignore)",
      "Read(./eslint.config.*)",
      "Read(./package.json)",
      "Read(./README.md)",
      "Read(./CLAUDE.md)",
      "Read(./PROJECT.md)",
      "Read(./tsconfig.json)",
      "Read(./src/**)",
      "Read(./.env.example)"
    ],
    "ask": [
      "Bash(curl *)",
      "Bash(wget *)",
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(git add:*)",
      "Bash(git checkout .)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git reset --hard *)",
      "Bash(cat .env)",
      "Bash(cat .env.*)",
      "Read(./.env)",
      "Read(**/.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./build/**)",
      "Read(./dist/**)",
      "Read(./.personal-dictionary.txt)"
    ],
    "disableBypassPermissionsMode": "disable",
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/morten/.claude/hooks/block-dangerous-git.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"/home/morten/.claude/hooks/context-mode-cache-heal.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "context-mode@context-mode": true,
    "i-have-adhd@i-have-adhd": true,
    "context7@context7-marketplace": true,
    "ponytail@ponytail": true,
    "superpowers@superpowers-marketplace": true
  },
  "extraKnownMarketplaces": {
    "context-mode": {
      "source": {
        "source": "github",
        "repo": "mksglu/context-mode"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "git",
        "url": "https://github.com/ayghri/i-have-adhd.git"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    },
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "context7-marketplace": {
      "source": {
        "source": "github",
        "repo": "upstash/context7"
      }
    }
  }
}
